{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "road-closure-interactive",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "road-closure.catseye.today",
      "zone_name": "catseye.today",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
  },
}
