{
  "name": "chicago-road-closure-interactive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "deploy": "wrangler deploy",
    "prebuild": "node scripts/write-build-info.mjs",
    "format:check": "prettier --check src data/rules.js scripts tests index.html README.md NOTICE.md wrangler.jsonc"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.2",
    "wrangler": "^4.147.0"
  }
}
